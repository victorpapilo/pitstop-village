# MongoDB Atlas connection string — get this from Atlas: Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pitstop-village

# Any long random string — used to sign admin login sessions
JWT_SECRET=change-this-to-a-long-random-string

# One-time secret used to create your first admin account via POST /api/auth/setup
ADMIN_SETUP_KEY=change-this-too

# Your deployed frontend URL(s), comma-separated. Use * while testing locally.
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
